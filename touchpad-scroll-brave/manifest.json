{
  "manifest_version": 3,
  "name": "Pomalejší touchpad",
  "version": "1.0.0",
  "description": "Zpomalí scrollování touchpadem, kolečko myši nechá na výchozí rychlosti.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "Rychlost scrollování touchpadem",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "popup/popup.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "js": ["src/detector.js", "src/shared.js", "src/content.js"]
    }
  ]
}
