# Lemma configuration. Copy to .env and edit; `.env` is never committed.
# Only LEMMA_PASSWORD is required. Everything else has a sensible default.

# ----------------------------------------------------------------------------- access

# The administrator's password. Used once, on first start, to create that account; after
# that it is stored (hashed) in the database and can be changed in Settings — changing it
# here later has no effect. At least 8 characters.
#
# The administrator is the account named "admin". While it is the only one, signing in
# takes this password alone; other accounts are created by the administrator in Settings.
#
# Keep it plain here — letters, digits, - _ . — and change it to whatever you like in
# Settings afterwards. In this file $, #, quotes and spaces have a meaning, and Docker
# Compose and podman-compose do not agree on all of it: unquoted, Docker reads pa$word as
# "pa" plus an unset variable named word. If you must: 'single quotes' keep a $ literal
# in both (only the sequence ${ is still best avoided).
LEMMA_PASSWORD=

# Forgot the administrator's password? Put a new one above, set this to 1, restart once,
# then remove it again. The administrator is signed out everywhere; other accounts are left
# alone. (While it stays at 1 the password is reset on every start.)
# LEMMA_PASSWORD_RESET=1

# Where the container is published on the host (compose only).
# 127.0.0.1 = this machine only, for a reverse proxy or tunnel on the same host.
# 0.0.0.0   = every interface, to reach it directly from the local network.
LEMMA_BIND=127.0.0.1
LEMMA_PORT=8000

# Behind HTTPS (reverse proxy, Cloudflare Tunnel, Tailscale Serve) set both to 1:
# COOKIE_SECURE marks the session cookie HTTPS-only; TRUST_PROXY makes the app believe
# the proxy's X-Forwarded-* headers (needed for the login throttle to see real clients).
# Leave both at 0 when you open http://host:8000 directly.
COOKIE_SECURE=0
TRUST_PROXY=0

# Only needed if the address in the browser differs from the Host header the app sees
# (some proxy set-ups rewrite it). Comma-separated, e.g. https://lemma.example.org
ALLOWED_ORIGINS=

# Set to 1 to switch signing-in off entirely. Only for a machine nobody else can reach.
AUTH_DISABLED=0

# ------------------------------------------------------------------------------- time

# Decides when a "study day" starts and ends, and therefore streaks and the heatmap.
LEMMA_TIMEZONE=Europe/Prague
# A study day rolls over at this hour, so a session past midnight still counts for the
# evening it began in.
DAY_START_HOUR=4

# ---------------------------------------------------------------------------- storage

# A consistent copy of the database is written to /data/backups once a day.
# How many daily copies to keep; 0 switches the automatic backup off.
BACKUP_KEEP=14

# Days a sign-in stays valid.
SESSION_DAYS=60

# debug | info | warn | error — logs are JSON lines on stdout.
LOG_LEVEL=info

# ------------------------------------------------------------- GitHub / Forgejo (optional)

# Shows your public contribution counts next to the maths activity. Usernames can also
# be set in Settings. No token is needed for public activity.
GITHUB_USERNAME=
# Optional: a fine-grained token with no permissions selected raises the rate limit and
# lets the contribution calendar (which GitHub only serves to signed-in callers) be read.
GITHUB_TOKEN=

FORGEJO_URL=
FORGEJO_USERNAME=
FORGEJO_TOKEN=

# ------------------------------------------------------------------- AI tutor (optional)

# The tutor is off unless one of the two set-ups below is filled in. Nothing else in
# Lemma depends on it, and it never decides whether an answer is right.
#
# AI_PROVIDER: anthropic | openai | none. Left empty, it is inferred from what is set.
AI_PROVIDER=

# (a) Claude, through the Anthropic API.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5. Any Claude 5 family model works (e.g. claude-sonnet-5-5
# for lower cost). Requests use adaptive thinking and, on Opus, the server-side fallback
# that re-runs a request on another model if a safety classifier declines it by mistake.
# AI_MODEL=claude-opus-5-5
# How much the model thinks before answering: low | medium | high | xhigh | max.
AI_EFFORT=medium
# Upper bound on one reply, thinking included.
AI_MAX_TOKENS=16000

# (b) A model on your own hardware, through any OpenAI-compatible server
#     (Ollama, llama.cpp, LM Studio, vLLM). AI_MODEL is required here.
#     Local models get no tools, so the tutor says when it cannot verify something.
#     From inside the container, "localhost" is the container. A server on the same
#     machine is host.docker.internal, and it has to listen on more than 127.0.0.1
#     (for Ollama: OLLAMA_HOST=0.0.0.0).
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_API_KEY=
# AI_MODEL=qwen3:14b

# ------------------------------------------- Linux & Infrastructure labs (optional)

# Hands-on labs need the lab worker, labd: a second container, started with the compose
# profile "labs" (README, "Linux & Infrastructure labs"). Without these two lines the
# mode still works for browsing — roadmap, library, skills — but no lab can start.
#
# LABD_TOKEN is a shared secret between lemma and labd, at least 24 characters:
#   openssl rand -hex 24
# LABD_URL=http://labd:7070
# LABD_TOKEN=

# The container engine labd creates lab machines with, as a socket on the HOST. labd is
# the only container that gets it. Rootful Docker: /var/run/docker.sock. Rootless Podman
# (recommended — lab machines then run as your unprivileged user):
#   systemctl --user enable --now podman.socket
#   LABD_ENGINE_SOCKET_HOST=/run/user/1000/podman/podman.sock  and  LABD_UID=1000
# LABD_ENGINE_SOCKET_HOST=/var/run/docker.sock
# The user labd runs as: one that may open that socket (root for rootful Docker).
# LABD_UID=0
# LABD_GID=0

# Limits. Each lab machine also has its own memory, CPU and process limits (per scenario).
# LABD_MAX_LABS=4                 labs running at once, all accounts together
# LABD_MAX_LABS_PER_OWNER=1       labs one account may run at once
# LABD_MAX_MEMORY_MB=2048         memory of all lab machines together
# LABD_MAX_DISK_MB=512            what one machine may write before it is stopped
# LABD_MAX_LIFETIME_MINUTES=240   a lab is removed this long after it started, however active
# Image builds: "" uses the engine's default network; "host" where bridges cannot work.
# LABD_BUILD_NETWORK=
# auto | yes | no — build lab images for an engine that maps a single user ID. auto probes.
# LABD_SINGLE_UID=auto

# ------------------------------------------- rootless Podman without subuid ranges only

# If `podman info` shows a uidmap of size 1 (typical for an unprivileged LXC), the image's
# own user does not exist inside the container. Run as the namespace's root instead —
# which is your own unprivileged user on the host. See README, "Rootless Podman".
# LEMMA_UID=0
# LEMMA_GID=0
