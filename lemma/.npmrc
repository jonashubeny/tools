# Install scripts of dependencies are not run. Nothing here needs them: the native
# pieces (SQLite, esbuild, Rolldown, Tailwind's engine) all ship prebuilt binaries.
#
# Besides being the safer default, this avoids an npm quirk: when installing from the
# lockfile, npm forgets that better-sqlite3 declares "gypfile": false and tries to compile
# it from source, which needs Python and a C++ toolchain and takes minutes.
ignore-scripts=true
fund=false
audit=false
